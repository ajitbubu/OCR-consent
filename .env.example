# Copy this file to .env. The backend loads it on startup; real environment
# variables take precedence, so `OCR_PROVIDER=google-vision uvicorn ...` still wins.

# OCR_PROVIDER may be tesseract or google-vision.
# tesseract is the default: it runs locally and needs no cloud credentials.
# It does need the Tesseract 5 binary (macOS: brew install tesseract).
OCR_PROVIDER=tesseract

# For google-vision, authenticate with your own Google account:
#   gcloud auth application-default login
# Never commit a service account key or share one between people.

# English handwriting hint used for the filled pilot forms. Leave empty for automatic detection.
OCR_LANGUAGE_HINTS=en-t-i0-handwrit

# Optional regional endpoint: us-vision.googleapis.com or eu-vision.googleapis.com.
GOOGLE_CLOUD_VISION_ENDPOINT=

# Keep false when Google processing must be verifiable; true permits local fallback on an API error.
OCR_GOOGLE_FALLBACK=false
