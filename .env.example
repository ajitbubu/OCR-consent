# OCR_PROVIDER may be tesseract or google-vision.
OCR_PROVIDER=google-vision

# English handwriting hint used for the filled pilot forms. Leave empty for automatic detection.
OCR_LANGUAGE_HINTS=en-t-i0-handwrit

# Optional regional endpoint: us-vision.googleapis.com or eu-vision.googleapis.com.
GOOGLE_CLOUD_VISION_ENDPOINT=

# Keep false when Google processing must be verifiable; true permits local fallback on an API error.
OCR_GOOGLE_FALLBACK=false
